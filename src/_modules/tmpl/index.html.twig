<!DOCTYPE html>

<html lang="ja">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="format-detection" content="telephone=no">
<meta name="robots" content="noindex,nofollow,noarchive">
<title>{{ title }}</title>
<link rel="stylesheet" href="./css/style.css">
<link rel="stylesheet" href="https://unpkg.com/cal-heatmap/dist/cal-heatmap.css">
<script src="https://d3js.org/d3.v7.min.js"></script>
<script src="https://unpkg.com/cal-heatmap/dist/cal-heatmap.min.js"></script>
<script src="https://unpkg.com/@popperjs/core@2"></script>
<script src="https://unpkg.com/cal-heatmap/dist/plugins/Tooltip.min.js"></script>

<script src="./js/script.js" defer></script>
</head>
<body>

<div class="wrapper">

	<h1>{{ title }}</h1>

  <div class="scroll_area">
    <div id="cal-heatmap"></div>
  </div>

  {% if error %}
    <ul class="error">
      {% for msg in error %}
        <li>{{ msg }}</li>
      {% endfor %}
    </ul>
  {% endif %}

    <div class="form_area">

      {% if isAdmin %}

        {% if sendSuccess %}
          <p class="success">入力完了！</p>
        {% endif %}

        <form action="" method="post" id="dataForm">
          <input type="hidden" name="token" value="{{ token }}">
          <dl>
            <dt>reading page total number...</dt>
            <dd><input type="text" name="number"></dd>
          </dl>

          <div class="btn_area">
            <button type="submit" name="send_num">送信</button>
          </div>
        </form>

      {% else %}

        <form action="" method="post" id="lginForm">
          <input type="hidden" name="token" value="{{ token }}">
          <dl>
            <dt>login password...</dt>
            <dd><input type="password" name="password"></dd>
          </dl>

          <div class="btn_area">
            <button type="submit" name="send_login">送信</button>
          </div>
        </form>
      
      {% endif %}

    </div>

</div>

</body>
</html>